<style>
  body {
    background: url('assets/bglogin.jpg') no-repeat center center fixed;
    background-size: cover;
  }
</style>

<div class="container d-flex justify-content-center align-items-center vh-100">
  <div class="login-container text-center">
    <!-- Logo -->
    <img src="assets/logo.png" alt="Logo" class="login-logo">

    <!-- Login Form -->
    <form action="/auth/login" method="POST">
      <div class="mb-3">
        <input type="email" class="form-control" id="email" name="email" placeholder="email" required>
      </div>
      <div class="mb-3">
        <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
      </div>
      <button type="submit" class="btn btn-login w-100">Sign In</button>
    </form>

    <!-- Links -->
    <div class="mt-3">
      <a href="/forgot-password" class="link-light">Forgot password?</a>
    </div>
    <div class="mt-2">
      <span class="text-light">Don’t Have Account?</span>
      <a href="/auth/signup" class="link-light">Create New Account</a>
    </div>
  </div>
</div>