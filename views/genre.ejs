<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genre</title>
    <link rel="stylesheet" href="/public/css/watchliststyle.css">
</head>
<body class="genre-page">
    <h1>Genres</h1>
    <div id="list"></div>
</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    function PageLoad() {
        $.ajax({
            url: '/users/genre', // Endpoint API Anda
            type: 'GET',
            contentType: 'application/json',
            success: function (data) {
                const { movieList } = data;
                const listContainer = $('#list');

                // Iterasi setiap genre dan filmnya
                movieList.forEach(genreData => {
                    const { genre, movieList } = genreData;

                    // Membuat elemen genre
                    const genreSection = $(`
                        <div class="genre-section">
                            <h2>${genre}</h2>
                            <div class="movie-container"></div>
                        </div>
                    `);

                    const movieContainer = genreSection.find('.movie-container');

                    // Menambahkan setiap film ke dalam container genre
                    movieList.forEach(movie => {
                        const movieElement = $(`
                        <a href="movie/${movie.id}">
                            <div class="movie-card">
                                <img src="https://${movie.thumbnail}" alt="${movie.title}">
                                <h3>${movie.title}</h3>
                            </div>
                        </a>
                            
                        `);
                        movieContainer.append(movieElement);
                    });

                    listContainer.append(genreSection);
                });
            },
            error: function (error) {
                console.error('Error fetching genres:', error.responseText);
                $('#list').text('Failed to load genres.');
            }
        });
    }

    // Memanggil fungsi PageLoad saat halaman dimuat
    PageLoad();
});
</script>
