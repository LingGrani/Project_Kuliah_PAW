<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genre</title>
    <link rel="stylesheet" href="/public/css/watchliststyle.css">
</head>
<body class="genre-page">
    <h1>Genre</h1>
    <div id="list">

    </div>
</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    function PageLoad() {
        $.ajax({
            url: '/users/genre', // Endpoint API Anda
            type: 'GET',
            contentType: 'application/json',
            success: function (response) {
                let list = "";
                console.log(response); // Memeriksa apakah data sudah benar

                // Iterasi untuk setiap genre dalam genreList
                response.genreList.forEach(genre => {
                    // Menambahkan judul genre
                    list += `<h2>${genre.genre}</h2>`;
                    // Iterasi untuk setiap film dalam movieList di genre
                    genre.movieList.forEach(movie => {
                        // Memastikan URL thumbnail lengkap dengan 'https://'
                        const thumbnailUrl = movie.thumbnail.startsWith('http') ? movie.thumbnail : 'https://' + movie.thumbnail;

                        // Menambahkan informasi film (thumbnail dan title)
                        list += `
                            <div class="carousel-container1">
                                <img src="${thumbnailUrl}" class="thumbnail" alt="${movie.title}">
                            </div>
                        `;
                    });
                });

                // Menampilkan list di elemen #list
                $('#list').html(list);
            },
            error: function (error) {
                console.error('Error fetching genre data:', error.responseText);
            }
        });
    }

    // Memanggil fungsi PageLoad saat halaman dimuat
    PageLoad();
});  
</script>