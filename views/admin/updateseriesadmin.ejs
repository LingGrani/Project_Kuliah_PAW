<div class="container">
    <div class="section-header">
      <h2 class="section-title">Video :</h2>
    </div>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Video ID</th>
            <th>Movie ID</th>
            <th>Video Title</th>
            <th>Episode Number</th>
            <th>Duration</th>
            <th>Video Link</th>
            <th>Season Index</th>
            <th>Thumbnail</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% videos.forEach(video => { %>
            <tr>
              <td><%= video.videoID %></td>
              <td><%= video.movieID %></td>
              <td><%= video.videoTitle %></td>
              <td><%= video.episodeNumber %></td>
              <td><%= video.duration %></td>
              <td><a href="<%= video.videoLink %>" target="_blank">Watch</a></td>
              <td><%= video.seasonIndex %></td>
              <td>
                <img src="<%= video.thumbnail %>" alt="<%= video.videoTitle %>" width="100">
              </td>
              <td>
                <button type="button" class="delete-btn" style="background-color: red;" onclick="deleteVideoFromForm(<%= video.videoID %>)">Delete Video</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    
    <!-- Form for uploading or updating video -->
    <h1>Upload/Update Video</h1>
    <div class="container" id="videoAdd">
      <form id="videoForm" onsubmit="submitForm(event)">
        <label for="videoID">Video:</label>
        <select id="videoID" name="videoID" required>
          <option value="">Pilih Video</option>
          <% movies.forEach(movie => { %>
            <option value="<%= movie.movieID %>"><%= movie.title %></option>
          <% }); %>
        </select>

        <label for="videoTitle">Video Title:</label>
        <input type="text" id="videoTitle" name="videoTitle" required>
    
        <label for="episodeNumber">Episode Number:</label>
        <input type="number" id="episodeNumber" name="episodeNumber" required>
    
        <label for="duration">Duration:</label>
        <input type="text" id="duration" name="duration" required>
    
        <label for="videoLink">Video Link:</label>
        <input type="file" id="videoLink" name="videoLink" accept="video/*"><br><br>

        <label for="seasonIndex">Season Index:</label>
        <input type="number" id="seasonIndex" name="seasonIndex" required>
    
        <label for="thumbnail">Thumbnail:</label>
        <input type="file" id="thumbnail" name="thumbnail" accept="image/*"><br><br>

        <div class="progress-container" style="display: none; margin-top: 20px;">
            <progress id="uploadProgress" max="100" value="0" style="width: 100%;"></progress>
            <span id="uploadPercentage">0%</span>
        </div>
        <div class="buttons">
          <button type="submit" class="submit-btn">Save Video</button>
        </div>
      </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  function openEditForm(videoID) {
    $.ajax({
      url: `/admin-crud/video/${videoID}`,
      method: 'GET',
      success: function (video) {
        $('#videoID').val(video.videoID);
        $('#videoTitle').val(video.videoTitle);
        $('#episodeNumber').val(video.episodeNumber);
        $('#duration').val(video.duration);
        $('#seasonIndex').val(video.seasonIndex);
      },
      error: function (err) {
        alert('Failed to fetch video details!');
      }
    });
  }

  function deleteVideoFromForm(videoID) {
    if (confirm('Are you sure you want to delete this video?')) {
      $.ajax({
        url: `/admin-crud/video/${videoID}`,
        method: 'DELETE',
        success: function () {
          alert('Video deleted successfully!');
          location.reload();
        },
        error: function () {
          alert('Failed to delete video!');
        }
      });
    }
  }

