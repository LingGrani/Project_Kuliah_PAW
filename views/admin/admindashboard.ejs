<link rel="stylesheet" href="/css/admindashboard.css">
<!-- Main Content -->
  <div class="main-content">
    <div class="overview-cards">
      <div class="card">
        <div class="card-header">Users</div>
        <div class="card-body">
          <h2><%= visitors %></h2>
        </div>
      </div>
      <div class="card">
        <div class="card-header">Movies</div>
        <div class="card-body">
          <h2><%= topMovies.length %></h2>
        </div>
      </div>
    </div>

    <!-- Top Movies -->
    <div class="top-movies">
      <h3>Top Movies</h3>
      <% topMovies.forEach(function(movie) { %>
        <div class="movie-card">
          <img src="<%= movie.image %>" alt="Movie Image" class="movie-image">
          <div class="movie-info">
            <h4><%= movie.name %></h4>
            <p><%= movie.year %></p>
            <p><%= movie.numReviews %> Comments</p>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Real-Time Data -->
    <div class="real-time">
      <h3>Realtime Data</h3>
      <div class="realtime-info">
        <h4><%= visitors %></h4>
        <p>Current Users</p>
      </div>
    </div>
  </div>

