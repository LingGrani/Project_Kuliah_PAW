            <div class="card-body">
              <h5 class="card-title">Episode 3</h5>
              <p>Duration: 52 minutes</p>
              <div class="episode-description">
                <p class="episode-text">This is the third episode's description...</p>
                <div class="progress-bar">
                  <div class="progress" style="width: 100%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
  
        <!-- Episode 4 -->
        <div class="col-md-2">
          <div class="card text-center">
            <div class="position-relative">
              <img src="./assets/eps4wdy.jpg" class="card-img-top" alt="Episode 4">
