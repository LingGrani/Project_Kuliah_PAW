            </div>
          </div>
        </div>
  
        <!-- Episode 5 -->
        <div class="col-md-2">
          <div class="card text-center">
            <div class="position-relative">
              <img src="./assets/eps5wdy.jpg" class="card-img-top" alt="Episode 5">
            </div>
            <div class="card-body">
              <h5 class="card-title">Episode 5</h5>
              <p>Duration: 50 minutes</p>
              <div class="episode-description">
                <p class="episode-text">This is the fifth episode's description...</p>
                <div class="progress-bar">
                  <div class="progress" style="width: 65%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
  
        <!-- Episode 6 -->
        <div class="col-md-2">
          <div class="card text-center">
            <div class="position-relative">
              <img src="./assets/eps6wdy.jpg" class="card-img-top" alt="Episode 6">
            </div>
            <div class="card-body">
              <h5 class="card-title">Episode 6</h5>
              <p>Duration: 54 minutes</p>
              <div class="episode-description">
                <p class="episode-text">This is the sixth episode's description...</p>
                <div class="progress-bar">
                  <div class="progress" style="width: 65%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
  
        <!-- Episode 7 -->
        <div class="col-md-2">
            <div class="card text-center">
              <div class="position-relative">
                <img src="./assets/eps7wdy.jpg" class="card-img-top" alt="Episode 6">
              </div>
              <div class="card-body">
                <h5 class="card-title">Episode 7</h5>
                <p>Duration: 34 minutes</p>
                <div class="episode-description">
                  <p class="episode-text">This is the seven episode's description...</p>
                  <div class="progress-bar">
                    <div class="progress" style="width: 15%;"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Episode 8 -->
        <div class="col-md-2">
            <div class="card text-center">
              <div class="position-relative">
                <img src="./assets/eps8wdy.jpg" class="card-img-top" alt="Episode 6">
              </div>
              <div class="card-body">
                <h5 class="card-title">Episode 8</h5>
                <p>Duration: 42 minutes</p>
                <div class="episode-description">
                  <p class="episode-text">This is the eight episode's description...</p>
                  <div class="progress-bar">
                    <div class="progress" style="width: 55%;"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>


      </div>
    </div>
  </div>
  

    <!-- Categories Section -->
    <div class="category-section">
      <div class="container">
        <!-- Action -->
        <h2>More Like This</h2>
        <div class="category-row">
          <div class="category-card"><img src="./assets/image2.jpg" alt="Action 1" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image3.jpg" alt="Action 2" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image4.jpg" alt="Action 3" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image5.jpg" alt="Action 4" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image6.jpg" alt="Action 5" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image1.jpg" alt="Action 6" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image2.jpg" alt="Action 7" class="img-fluid"></div>
        </div>
        <!-- Romance & Drama -->
        <div class="category-row">
          <div class="category-card"><img src="./assets/imageromance.jpg" alt="Romance 1" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image4.jpg" alt="Romance 2" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image5.jpg" alt="Romance 3" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image6.jpg" alt="Romance 4" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image1.jpg" alt="Romance 5" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image2.jpg" alt="Romance 6" class="img-fluid"></div>
          <div class="category-card"><img src="./assets/image3.jpg" alt="Romance 7" class="img-fluid"></div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
