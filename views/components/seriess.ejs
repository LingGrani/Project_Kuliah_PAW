<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SeriesPage</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
         .hero-section {
    position: relative;
    color: white;
    text-align: left; /* Mengatur teks rata kiri */
    background: url('./assets/wednesdayimage.jpg') no-repeat center center/cover;
    height: 600px;
    display: flex; /* Gunakan Flexbox */
    align-items: center; /* Atur konten di tengah secara vertikal */
    padding-left: 50px; /* Memberikan padding untuk jarak dari kiri */
    padding-top: 200px;
  }
  .hero-section .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 600px; /* Batasi lebar konten */
  }
  .hero-content h1 {
    font-size: 4rem;
    font-weight: bold;
  }
  .movie-details {
    font-size: 1rem;
    margin: 40px 0;
  }
  .movie-buttons .btn {
    margin: 5px;
    padding: 10px 20px;
    font-size: 1.2rem;
    margin-top: 2.75rem;
  }
  /* Mengubah warna latar belakang container */
.trending-section{
    background-color: black;
}

.container {
    background-color: #000; /* Warna hitam */
    color: black; /* Mengubah teks menjadi putih untuk kontras */
    padding: 1px; /* Memberikan padding agar konten tidak menempel pada sisi container */
    border-radius: 10px; /* Menambahkan radius pada sudut */
    margin-left: 53px;
}

.category-roww {
  display: flex; /* Display items in a row */
  overflow-x: auto; /* Enable horizontal scrolling */
  gap: 20px; /* Space between the cards */
  padding: 10px 
}

.category-roww .col-md-2 {
  flex: 0 0 auto; /* Prevent the cards from shrinking */
  width: 220px; /* Set the width of the card */
}

.category-roww::-webkit-scrollbar {
  height: 8px;
}

.category-roww::-webkit-scrollbar-thumb {
  background-color: #444;
  border-radius: 10px;
}

.category-roww::-webkit-scrollbar-track {
  background-color: #222;
}

.d-flex {
    display: flex;
    justify-content: flex-start; /* Tombol akan berada di kiri */
    gap: 10px; /* Menambahkan jarak antar tombol */
    margin-top: 4rem;
    border-radius: 30px;
}

.card-body {
    padding: 15px;
    position: relative;
}

.card-title {
    font-size: 1.25rem;
    font-weight: bold;
}


.episode-description {
    margin-top: 10px;
}

.episode-text {
    color: white; /* Mengubah warna teks menjadi tomat */
}

.progress-bar {
    height: 3px;
    background-color: grey;
    margin-top: 5px;
}

.progress {
    height: 3px;
    background-color: white; 
}

h2 {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    margin-bottom: 20px;
}

/* Adjustments for better card and image styling */
.card-img-top {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}

.card {
    background-color: black; /* Menjaga warna gelap pada card */
    border-radius: 10px;
    border: none;
}

.card-body {
    color: white;
    padding: 10px;
    background: #222;
}

.progress-bar .progress {
    transition: width 0.5s ease;
}

        .category-section {
          padding: 50px 0;
          background: black;
          color: white;
        }
        .category-section h2 {
          margin-bottom: 20px;
        }
        .category-row {
          display: flex;
          overflow-x: auto;
          gap: 20px;
          padding-bottom: 30px;
          scroll-behavior: smooth;
        }
        .category-row::-webkit-scrollbar {
          height: 8px;
        }
        .category-row::-webkit-scrollbar-thumb {
          background-color: #444;
          border-radius: 10px;
        }
        .category-row::-webkit-scrollbar-track {
          background-color: #222;
        }
        .category-card {
            min-width: 250px; /* Ukuran lebih kecil */
            flex: 0 0 auto;
            background: #222;
            border: none;
            border-radius: 15px;
            padding: 5px; /* Berikan padding kecil */
        }
        .category-card img {
            border-radius: 10px;
            width: 100%; /* Pastikan gambar memenuhi lebar card */
            height: auto; /* Menjaga proporsi gambar */
            max-height: 200px; /* Atur tinggi maksimum */
            object-fit: cover; /* Agar gambar tetap proporsional */
        }
      </style>
    </head>
    <body>
      <!-- Hero Section -->
      <div class="hero-section">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Wednesday</h1>
          <div class="movie-details">
            <span>CBFC: U/A</span> | <span>Action</span> | <span>Adventure</span> | <span>2h 28m</span>
            <div class="movie-buttons">
                <button class="btn btn-primary">Watch Now</button>
                <button class="btn btn-outline-light">Add Watchlist</button>
              </div>
          </div>
          <p>When a spell goes wrong, dangerous foes from other worlds start to appear, forcing Peter to discover what it truly means to be Spider-Man.</p>
        </div>
      </div>
  
     <!-- Episodes Section -->
<div class="trending-section">
    <div class="container">
      <!-- Tombol Episodes dan User Reviews -->
      <div class="d-flex justify-content-start mb-4">
        <button class="btn btn-primary btn-sm me-2">Episodes</button>
      </div>
      
      <!-- Episode Titles -->
      <div class="mb-4">
        <h2>Episodes 1-8</h2>
      </div>
  
      <!-- Cards for Episodes (Scroll horizontally) -->
      <div class="category-roww">
        <!-- Episode 1 -->
        <div class="col-md-2">
          <div class="card text-center">
            <div class="position-relative">
              <img src="./assets/eps1wdy.jpg" class="card-img-top" alt="Episode 1">
            </div>
            <div class="card-body">
              <h5 class="card-title">Episode 1</h5>
              <p>Duration: 52 minutes</p>
              <div class="episode-description">
                <p class="episode-text">This is the first episode's description...</p>
                <div class="progress-bar">
                  <div class="progress" style="width: 70%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
  
        <!-- Episode 2 -->
        <div class="col-md-2">
