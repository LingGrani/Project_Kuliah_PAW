<link rel="stylesheet" href="/css/seriess.css">

<div class="hero-section" style="background: url('https://<%= movie.thumbnail %>') no-repeat center center/cover">
  <div class="overlay"></div>
  <div class="hero-content">
    <h1><%= title %></h1>
    <div class="movie-details">
      <span>CBFC: <%= movie.cbfc %></span> | <span><%= movie.genre %></span>
    </div>
    <p><%= movie.description %></p>
  </div>
</div>

<div class="trending-section">
  <div class="container">
    <div class="d-flex justify-content-start mb-4">
      <button class="btn btn-primary btn-sm me-2">Episodes</button>
    </div>
    <div class="mb-4">
      <!-- Tempat video player -->
      <div class="video-container">
        <video id="videoPlayer" width="100%" controls>
          <source id="videoSource" src="" type="video/*">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
    <div class="category-roww" id="episode">
      <% episodes.forEach(episode => { %>
        <div class="col-md-2" data-videolink="<%= episode.videoLink %>">
          <div class="card text-center">
            <div class="position-relative">
              <img src="<%= episode.thumbnail %>" class="card-img-top" alt="Episode <%= episode.episodeNumber %>">
            </div>
            <div class="card-body">
              <h5 class="card-title">Episode <%= episode.episodeNumber %> <%= episode.videoTitle %></h5>
              <p>Duration: <%= episode.duration %></p>
              <div class="episode-description">
                <div class="progress-bar">
                  <div class="progress" style="width: 70%;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
  $(document).ready(function () {
    // Ketika episode diklik, ganti video yang diputar
    $('#episode .col-md-2').click(function() {
      // Ambil video link dari data atribut
      var videoLink = $(this).data('videolink');
      
      // Set src video ke video link yang dipilih
      $('#videoSource').attr('src', videoLink);
      // Perbarui video player dan mulai pemutaran
      $('#videoPlayer')[0].load();
      $('#videoPlayer')[0].play();
    });

    // Mengambil data film dari server (misalnya)
    function PageLoad() {
      $.ajax({
        url: '/users/movie',
        type: 'GET',
        contentType: 'application/json',
        success: function (movies) {
          // Anda bisa menambahkan logika di sini jika perlu
        },
        error: function (error) {
          console.error('Error adding task:', error.responseText);
        }
      });
    }
    PageLoad();
  });
</script>
