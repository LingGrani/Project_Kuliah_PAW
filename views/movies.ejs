<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies</title>
    <link rel="stylesheet" href="/public/css/style.css">

</head>
<body class="movies-page">
    <h1>Movies</h1>
    <h2>For You:</h2>
    <div class="carousel-container1" id="list">
        
    </div>
</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    function PageLoad() {
        $.ajax({
            url: '/users/movie',
            type: 'GET',
            contentType: 'application/json',
            success: function (movies) {
                let list = "";
                console.log(movies)
                console.log('Task successfully added:', movies);
                for (var i = 0; i < movies.movieList.length; i++) {         
                    list += `
                    <a href="movie/${movies.movieList[i].movieID}">
                        <img src="https://${movies.movieList[i].thumbnail}" class="thumbnail" alt="${movies.movieList[i].movieID}">
                    </a>
                    `
                }
                document.getElementById('list').innerHTML = list
                },
                error: function (error) {
                    console.error('Error adding task:', error.responseText);
                }
            });
        }

        PageLoad();
      });   
</script>