    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
      $(document).ready(function () {
        function PageLoad() {
            $.ajax({
                url: '/users',
                type: 'GET',
                contentType: 'application/json',
                success: function (movies) {
                  let list = "";
                    console.log('Task successfully added:', movies);
                    let random = `
                    <div style="background: url('https://${movies.randomMovie.thumbnail}')center/cover;">
                      <div class="hero-section">
                        <div class="overlay"></div>
                        <div class="hero-content">
                          <h1>${movies.randomMovie.title}</h1>
                          <div class="movie-details">
                            <span>${movies.randomMovie.cbfc}</span> | <span>${movies.randomMovie.genre}</span> | <spam>${movies.randomMovie.releaseYear}</span>
                          </div>
                          <p>${movies.randomMovie.description}</p>
                          <div class="movie-buttons">
                            <a class="btn btn-primary" href=movie/${movies.randomMovie.movieID}>Watch Now</a>
                            <button class="btn btn-outline-light">More Info</button>
                          </div>
                        </div>
                      </div>
                    </div>
                    `;
                    for (var i = 0; i < movies.series.length; i++) {
                      
                      list += `
                      <div class="col-md-2" ">
                        <div class="card text-center">
                          <div class="position-relative">
                            <a href="/movie/${movies.series[i].movieID}">
                              <div class="number-overlay">${i}</div>
                              <img src="https://${movies.series[i].thumbnail}" class="card-img-top" alt="Movie 1">
                            </a>
                          </div>
                          <div class="card-body">
                            <h5 class="card-title">${i}</h5>
                          </div>
                        </div>
                      </div>
                      `
                    }
                    document.getElementById('list').innerHTML = list
                    document.getElementById('hero').innerHTML = random
                },
                error: function (error) {
                    console.error('Error adding task:', error.responseText);
                }
            });
        }

        PageLoad();
      });
    </script>
