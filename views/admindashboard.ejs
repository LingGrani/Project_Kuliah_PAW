<link rel="stylesheet" href="/css/admindashboard.css">

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body class="dashboard">

  <!-- Sidebar -->
  <div class="sidebar">
    <ul>
      <li class="sidebar-item active">
        <a href="/admindashboard" class="sidebar-link">Dashboard</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/create" class="sidebar-link">Upload Movie</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/create" class="sidebar-link">Upload Series</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/create" class="sidebar-link">Create Genre</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/create" class="sidebar-link">See All Movie & Series</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/update" class="sidebar-link">Update Movie</a>
      </li>
      <li class="sidebar-item">
        <a href="/admin/update" class="sidebar-link">Update Series</a>
      </li>
    </ul>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <div class="overview-cards">
      <div class="card">
        <div class="card-header">Users</div>
        <div class="card-body">
          <h2><%= visitors %></h2>
        </div>
      </div>
      <div class="card">
        <div class="card-header">Comments</div>
        <div class="card-body">
          <h2><%= sumOfCommentsLength %></h2>
        </div>
      </div>
      <div class="card">
        <div class="card-header">Movies</div>
        <div class="card-body">
          <h2><%= topMovies.length %></h2>
        </div>
      </div>
    </div>

    <!-- Top Movies -->
    <div class="top-movies">
      <h3>Top Movies</h3>
      <% topMovies.forEach(function(movie) { %>
        <div class="movie-card">
          <img src="<%= movie.image %>" alt="Movie Image" class="movie-image">
          <div class="movie-info">
            <h4><%= movie.name %></h4>
            <p><%= movie.year %></p>
            <p><%= movie.numReviews %> Comments</p>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Real-Time Data -->
    <div class="real-time">
      <h3>Realtime Data</h3>
      <div class="realtime-info">
        <h4><%= visitors %></h4>
        <p>Current Users</p>
      </div>
    </div>
  </div>

</body>
</html>
